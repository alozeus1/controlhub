# =============================================================================
# ENVIRONMENT
# =============================================================================
# Set to "production" to enforce required secrets
ENVIRONMENT=development

# =============================================================================
# SECURITY KEYS (REQUIRED in production, optional in development)
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
# Comma-separated Fernet keys for encrypting secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEYS=

# --- Secrets at rest: KMS envelope encryption (production) -------------------
# When set, secrets are envelope-encrypted with a per-write data key from KMS and
# the app holds NO master key — every read costs a kms:Decrypt that CloudTrail
# records and IAM can gate. Leave empty to fall back to the Fernet keys above,
# which live in this process's environment (dev only: anyone who can read the
# app env can decrypt the database).
# Accepts a key id, ARN, or alias, e.g. alias/controlhub-secrets
SECRET_KMS_KEY_ID=
# Override the provider toggle if KMS lives somewhere other than STORAGE_PROVIDER
# implies ("localstack" | "aws").
SECRET_KMS_PROVIDER=
# After setting SECRET_KMS_KEY_ID, migrate existing values:  flask secrets rewrap
# (existing fernet:v1: records keep working until you do — no downtime needed)

# --- Audit mirror: out-of-band copy of the audit log -------------------------
# The hash chain makes tampering detectable; this makes it PROVABLE by keeping a
# copy the app cannot rewrite. "cloudwatch" | "file" | "none".
# Protect the destination server-side (CloudWatch resource policy denying
# Delete*, or S3 Object Lock) — the append-only guarantee lives there, not here.
AUDIT_MIRROR_SINK=none
AUDIT_MIRROR_LOG_GROUP=/controlhub/audit
AUDIT_MIRROR_LOG_STREAM=audit-chain
AUDIT_MIRROR_FILE=/var/log/controlhub/audit-mirror.jsonl

# --- Just-in-time privilege elevation ----------------------------------------
# EMPTY = off (default). Listed permissions stop being standing power: holders
# must activate them with a reason + fresh second factor, for a short window.
# The grant is bound to the session that requested it, so a different stolen
# token for the same user cannot ride it.
#
# Recommended starting point (gate what is dangerous, NOT what is frequent —
# note manage_users is excluded: it is routine work for hr_admin/people_manager,
# and gating routine work is how the whole control ends up switched off):
#   JIT_ELEVATED_PERMISSIONS=manage_secrets,manage_roles,manage_sso,manage_org_settings
JIT_ELEVATED_PERMISSIONS=
# Subset that also needs a SECOND person to approve. Verify at least two
# eligible approvers exist first — otherwise you lock yourself out entirely.
#   JIT_DUAL_APPROVAL_PERMISSIONS=manage_roles,manage_sso
JIT_DUAL_APPROVAL_PERMISSIONS=
JIT_ELEVATION_TTL_MINUTES=15
# true = MFA only, no password fallback. Every eligible operator must be
# enrolled first or they cannot elevate at all.
JIT_REQUIRE_MFA=false
# Schedule:  flask audit mirror   (every minute)
#            flask audit verify   (hourly; exits non-zero on divergence — alarm on it)

# =============================================================================
# DATABASE
# =============================================================================
# Use 'db' as host for Docker Compose, 'localhost' for local dev
SQLALCHEMY_DATABASE_URI=postgresql://postgres:password@db:5432/flaskdb

# Postgres container settings (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=flaskdb

# =============================================================================
# JWT OPTIONS
# =============================================================================
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800
JWT_TOKEN_LOCATION=headers
JWT_HEADER_NAME=Authorization
JWT_HEADER_TYPE=Bearer

# =============================================================================
# REDIS
# =============================================================================
# Use 'redis' as host in Docker Compose, 'localhost' for local dev
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URL=redis://redis:6379/0

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Number of reverse proxies you control in front of the app. MUST be 1 for the
# nginx-fronted deployment: without it remote_addr is nginx's IP, so per-IP rate
# limits (including the login limiter) collapse into one global bucket and audit
# source IPs are meaningless. Leave 0 only when the app is directly exposed.
TRUSTED_PROXY_COUNT=0

# =============================================================================
# EMAIL / PASSWORD RESET
# =============================================================================
# NOTE: SMTP below is now a FALLBACK. When SES_TRANSACTIONAL_FROM_ADDRESS is set
# (see the email campaigns section), password resets and account notifications
# are delivered through Amazon SES and these MAIL_* values are unused.
MAIL_SERVER=zd26nafmaxez.fips.wmjb.mail-manager-smtp.amazonaws.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=inp-pu5oh6mug4wfkvd42uw5brfm
MAIL_PASSWORD=Webforxtechng@2026
MAIL_DEFAULT_SENDER=no-reply@dev.webforxtech.com
SES_ALLOWED_SENDER_DOMAINS=webforxtech.com,dev.webforxtech.com
TRUSTED_PROXY_COUNT=1

# How long password reset links are valid (in minutes)
PASSWORD_RESET_EXPIRES_MINUTES=60

# =============================================================================
# S3 / STORAGE CONFIGURATION
# =============================================================================
# Storage provider: "localstack" for local dev, "aws" for production
STORAGE_PROVIDER=localstack

# S3 bucket name (same for LocalStack and AWS)
S3_BUCKET_NAME=controlhub-uploads

# AWS region
AWS_REGION=us-east-1

# LocalStack endpoint (only used when STORAGE_PROVIDER=localstack)
# Use "http://localstack:4566" in Docker, "http://localhost:4566" for local dev
AWS_ENDPOINT_URL=http://localstack:4566

# AWS credentials (use "test" for LocalStack, real credentials for AWS)
# For production AWS, prefer IAM roles or environment-based credential chain
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# =============================================================================
# UPLOAD LIMITS
# =============================================================================
# Maximum file size in bytes (default: 50MB)
MAX_UPLOAD_SIZE=52428800

# Allowed content types (comma-separated, empty = allow all)
ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,text/csv,application/json,application/xml

# Presigned URL expiry in seconds (default: 15 minutes)
# Keep short for security-sensitive downloads.
PRESIGNED_URL_EXPIRY=300

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_SERVICE_ACCOUNTS=true
FEATURE_NOTIFICATIONS=true
FEATURE_INTEGRATIONS=true
FEATURE_ASSETS=true
FEATURE_PEOPLE=true
FEATURE_INTERNSHIP_PROGRAM=true
FEATURE_AGENT_SERVICE=true

# SaaS org-management integrations (mock mode by default; do not commit real values)
TAIGA_API_ENABLED=false
TAIGA_API_URL=
TAIGA_AUTH_TOKEN=
MATTERMOST_API_ENABLED=false
MATTERMOST_WEBHOOK_URL=
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=controlhub@notifications.webforxtech.com

# Agent service controls
AGENT_EXPORT_APPROVAL_ROW_THRESHOLD=200
# Cumulative rows one actor may queue for export per rolling 24h (0 disables).
# The per-request threshold above can be evaded by slicing one large export into
# many small ones; this caps the total. Tune to your largest legitimate report.
AGENT_EXPORT_DAILY_ROW_BUDGET=5000
AGENT_ARTIFACT_STORAGE=local
AGENT_ARTIFACTS_DIR=/tmp/controlhub-agent-artifacts
AGENT_ARTIFACT_URL_EXPIRY_SECONDS=300

# --- Agent egress allowlist (Phase 4) ----------------------------------------
# The REAL Google Drive folder ids / spreadsheet ids agent artifacts may be
# published to, comma-separated. Destination records validate only the SHAPE of
# a target, so without this anyone who can create a destination chooses where
# company data goes — including someone who has taken over an admin account.
#
# This lives in env rather than the database on purpose: compromising the
# application does not grant a new egress target, because adding one requires
# changing deployment config and redeploying.
#
# Empty = permissive with a startup warning, so upgrades do not break a working
# deployment. SET THESE IN PRODUCTION.
#   AGENT_EGRESS_DRIVE_FOLDERS=1a2b3cCorpHrReportsFolderId
#   AGENT_EGRESS_SHEETS=1x2y3zHeadcountSheetId
AGENT_EGRESS_DRIVE_FOLDERS=
AGENT_EGRESS_SHEETS=
ARTIFACTS_BUCKET_PREFIX=controlhub-artifacts
ARTIFACTS_KMS_KEY_ARN=

# Google Workspace publishing (keyless AWS WIF + DWD)
# Do not commit real values. Inject via secrets manager / runtime env.
GOOGLE_WIF_AUDIENCE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WIF_CREDENTIALS_PATH=config/google-wif-external-account.json
GOOGLE_IMPERSONATE_USER=
GOOGLE_ARTIFACTS_FOLDER_ID=
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/spreadsheets

# Optional explicit IAMCredentials endpoint (normally derived automatically)
GOOGLE_SERVICE_ACCOUNT_IMPERSONATION_URL=

# Legacy key-file vars (deprecated; keep empty when using WIF)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_IMPERSONATED_USER=

# =============================================================================
# REGISTRATION CONTROL
# =============================================================================
# Comma-separated list of allowed email domains (empty = no restriction)
# Example: ALLOWED_REGISTRATION_DOMAINS=mycompany.com,partner.com
ALLOWED_REGISTRATION_DOMAINS=

# =============================================================================
# EMAIL CAMPAIGNS MODULE (native "Mailchimp" via Amazon SES)
# =============================================================================
FEATURE_EMAIL_CAMPAIGNS=true

# Provider toggle: "localstack" for local dev, "aws" for Railway/production.
# Defaults to STORAGE_PROVIDER if unset.
EMAIL_PROVIDER=localstack

# Sender identity (must be a VERIFIED SES identity in production)
SES_FROM_ADDRESS=campaigns@controlhub.local
SES_FROM_NAME=Web Forx

# Verified SES sending domains, comma-separated. Exact match — subdomains are
# NOT implied, list each one. REQUIRED when EMAIL_PROVIDER=aws; the app refuses
# to boot if a configured sender falls outside this list.
# Production:  SES_ALLOWED_SENDER_DOMAINS=webforxtech.com,dev.webforxtech.com
SES_ALLOWED_SENDER_DOMAINS=

# Transactional sender (password resets, account notifications). Kept separate
# from the campaign identity so marketing volume cannot damage the reputation
# that operational email depends on. Falls back to SES_FROM_ADDRESS if unset.
# Production:  SES_TRANSACTIONAL_FROM_ADDRESS=noreply@webforxtech.com
# Staging:     SES_TRANSACTIONAL_FROM_ADDRESS=noreply@dev.webforxtech.com
SES_TRANSACTIONAL_FROM_ADDRESS=
SES_TRANSACTIONAL_FROM_NAME=Web Forx ControlHub
SES_TRANSACTIONAL_CONFIGURATION_SET=
SES_REPLY_TO_ADDRESS=

# SES configuration set that emits open/click/bounce/complaint events to SNS.
# Leave blank for LocalStack.
SES_CONFIGURATION_SET=

# Kill-switch: set to false for a dry run (no mail leaves the app).
SES_SENDING_ENABLED=true

# SNS topic ARN the webhook validates inbound events against (prod).
SNS_TOPIC_ARN=

# Public base URL used to build one-click unsubscribe links.
PUBLIC_BASE_URL=http://localhost:9000

# CAN-SPAM physical postal address rendered in the email footer.
ORG_POSTAL_ADDRESS=Web Forx Technology Limited

# RQ send queue + local-testing helpers
CAMPAIGN_QUEUE=campaigns
# Run sends inline (no worker) — handy for quick local tests:
CAMPAIGN_SEND_SYNC=false

# --- Production only (Railway secret store — NEVER commit real values) ---
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# --- n8n orchestration ---
N8N_BASE_URL=
N8N_WEBHOOK_PATH=/webhook/controlhub-email
N8N_WEBHOOK_SECRET=

# =============================================================================
# AUTH / REVOCATION SAFETY
# =============================================================================
# When the JWT revocation store (Redis) is unreachable, fail CLOSED (deny) by
# default so revoked/compromised tokens cannot be used during an outage.
# Set to true ONLY for a consciously-accepted bounded degraded mode. Keep false
# in production.
JWT_FAIL_OPEN=false
